<theme-toggle class="flex">
	<button class="icon-btn toggle-btn touch-manipulation" type="button">
		<span class="sr-only">Dark Theme</span>
		<svg
			aria-hidden="true"
			class="theme-icon theme-sun"
			fill="none"
			focusable="false"
			height="20"
			width="20"
			id="sun-svg"
			stroke-width="1.5"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path
				d="M12 18C15.3137 18 18 15.3137 18 12C18 8.68629 15.3137 6 12 6C8.68629 6 6 8.68629 6 12C6 15.3137 8.68629 18 12 18Z"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
			<path d="M22 12L23 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
			<path d="M12 2V1" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
			<path d="M12 23V22" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
			<path d="M20 20L19 19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
			<path d="M20 4L19 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
			<path d="M4 20L5 19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
			<path d="M4 4L5 5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
			<path d="M1 12L2 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
			></path>
		</svg>
		<svg
			aria-hidden="true"
			class="theme-icon theme-moon"
			fill="none"
			focusable="false"
			height="20"
			width="20"
			id="moon-svg"
			stroke="currentColor"
			stroke-width="1.5"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M0 0h24v24H0z" fill="none" stroke="none"></path>
			<path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"
			></path>
			<path d="M17 4a2 2 0 0 0 2 2a2 2 0 0 0 -2 2a2 2 0 0 0 -2 -2a2 2 0 0 0 2 -2"></path>
			<path d="M19 11h2m-1 -1v2"></path>
		</svg>
	</button>
</theme-toggle>

<style>
	/* both icons share one grid cell, so they stay centred without absolute positioning or translate */
	.toggle-btn {
		display: grid;
		place-items: center;
		overflow: hidden;
	}
	.theme-icon {
		grid-area: 1 / 1;
		width: 20px;
		height: 20px;
		transform-origin: center;
		transition:
			rotate 200ms var(--ease-out),
			scale 200ms var(--ease-out),
			opacity 200ms var(--ease-out);
	}
	.theme-sun {
		rotate: 0deg;
		scale: 1;
		opacity: 1;
	}
	.theme-moon {
		rotate: 45deg;
		scale: 0.9;
		opacity: 0;
	}
	:global([data-theme="dark"]) .theme-sun {
		rotate: -45deg;
		scale: 0.9;
		opacity: 0;
	}
	:global([data-theme="dark"]) .theme-moon {
		rotate: 0deg;
		scale: 1;
		opacity: 1;
	}
</style>

<script>
	import { rootInDarkMode } from "@/utils/domElement";

	class ThemeToggle extends HTMLElement {
		#button: HTMLButtonElement | null = null;

		#sync = () => {
			this.#button?.setAttribute("aria-checked", String(rootInDarkMode()));
		};

		// connectedCallback, not the constructor: children are not guaranteed to exist yet in the constructor
		connectedCallback() {
			this.#button = this.querySelector<HTMLButtonElement>("button");
			if (!this.#button) return console.warn("Theme Toggle: No button found");
			this.#button.setAttribute("role", "switch");
			this.#sync();
			this.#button.addEventListener("click", this.#onClick);
			// the theme can also change from the terminal, another tab or the OS
			document.addEventListener("theme-applied", this.#sync);
		}

		disconnectedCallback() {
			this.#button?.removeEventListener("click", this.#onClick);
			document.removeEventListener("theme-applied", this.#sync);
		}

		#onClick = () => {
			// dispatch event -> ThemeProvider.astro, which applies and persists it
			document.dispatchEvent(
				new CustomEvent("theme-change", { detail: { theme: rootInDarkMode() ? "light" : "dark" } }),
			);
			this.#sync();
		};
	}

	if (!customElements.get("theme-toggle")) customElements.define("theme-toggle", ThemeToggle);
</script>
