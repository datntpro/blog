---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About Ngo Tien Dat — developer, builder, and note-taker.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			Hi, I'm <strong>Ngo Tien Dat</strong> (<a
				class="cactus-link inline-block"
				href="https://github.com/datntpro"
				rel="noreferrer"
				target="_blank">@datntpro</a
			>). Welcome to my blog!
		</p>
		<p>
			This is my personal space where I take notes on things I learn, experiment with new technologies,
			and share my thoughts on software development. The name says it all — <em>just for note</em>.
		</p>
		<p>Here's what I'm into:</p>
		<ul class="list-inside list-disc" role="list">
			<li>Building web applications & developer tools</li>
			<li>Exploring cloud infrastructure & DevOps</li>
			<li>Learning and writing about modern tech stacks</li>
			<li>Open source contributions</li>
		</ul>
		<p>
			Feel free to explore my posts and notes. If you'd like to connect, find me on
			<a
				class="cactus-link inline-block"
				href="https://github.com/datntpro"
				rel="noreferrer"
				target="_blank">GitHub</a
			>.
		</p>
	</div>
</PageLayout>
