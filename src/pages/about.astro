---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About Ngo Tien Dat — Security Engineer & note-taker.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			Hi, I'm <strong>Ngo Tien Dat</strong> (<a
				class="cactus-link inline-block"
				href="https://github.com/datntpro"
				rel="noreferrer"
				target="_blank">@datntpro</a
			>), a Security Engineer focusing on Application Security. Welcome to my blog!
		</p>
		<p>
				This is my personal space where I take notes on things I learn, explore, and share my thoughts.
			The name says it all — <em>just for note</em>.
		</p>
		<p>Here's what I'm into:</p>
		<ul class="list-inside list-disc" role="list">
			<li>Application Security & Secure Development</li>
			<li>Security Engineering & DevSecOps</li>
			<li>Open source & building tools</li>
		</ul>
		<p>
			Feel free to explore my posts and notes. If you'd like to connect, find me on
			<a
				class="cactus-link inline-block"
				href="https://github.com/datntpro"
				rel="noreferrer"
				target="_blank">GitHub</a
			>.
		</p>
	</div>
</PageLayout>
