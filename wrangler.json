{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog",
	"compatibility_date": "2026-09-14",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
	"traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}