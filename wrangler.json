{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog",
	"compatibility_date": "2026-09-14",
	"main": "functions/api/summarize.ts",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"binding": "ASSETS"
	},
	"ai": {
		"binding": "AI"
	},
	"observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
	"traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}